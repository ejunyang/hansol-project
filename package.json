{
  "name": "hansol",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "homepage": ".",
  "author": "ejunyang",
  "description": "hansol",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "electron:start": "electron main.js",
    "electron:package:mac": "electron-builder -m -c.extraMetadata.main=main.js",
    "electron:package:win": "electron-builder --win --x64 -c.extraMetadata.main=main.js",
    "electron:package:linux": "electron-builder -l -c.extraMetadata.main=main.js"
  },
  "build": {
    "appId": "hansol",
    "productName": "hansol",
    "files": [
      "out/**/*",
      "main.js",
      "preload.js"
    ],
    "directories": {
      "buildResources": ""
    },
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/assets/app_icon.png",
      "sign": false,
      "verifyUpdateCodeSignature": false,
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": "deb"
    },
    "extends": null
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@tanstack/react-query": "^5.68.0",
    "@tanstack/react-query-devtools": "^5.68.0",
    "@tanstack/react-table": "^8.21.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "embla-carousel-react": "^8.5.2",
    "lucide-react": "^0.475.0",
    "moment": "^2.30.1",
    "next": "15.1.7",
    "react": "^19.0.0",
    "react-day-picker": "8.10.1",
    "react-dom": "^19.0.0",
    "react-zoom-pan-pinch": "^3.7.0",
    "tailwind-merge": "^3.0.2",
    "tailwind-scrollbar": "^4.0.1",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^35.0.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-config-next": "15.1.7",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
